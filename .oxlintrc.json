{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "categories": {},
  "rules": {
    // The rule this linter is here for: a hook called conditionally is a defect
    // with no upside, and there is no case in this codebase for one.
    "react/rules-of-hooks": "error",

    // A warning rather than an error, and deliberately. oxlint's reading of
    // exhaustive-deps is stricter than the React team's: it wants the whole
    // object where the code depends on one stable callback of it —
    // `[account.invalidateResults]` is reported as missing `account`. Obeying
    // it would make every dependency array coarser, since those objects are
    // new on each render, and would undo the memoisation the deps exist for.
    // Kept visible because it still catches the real case: a callback left out
    // of the array entirely, which is how the admin question loader lost track
    // of its own dependency before it was moved into a hook.
    "react/exhaustive-deps": "warn",

    // Both flag patterns this codebase chose on purpose and documented where
    // they are used: the relay refs in App.tsx that break a dependency cycle
    // between the settings and session hooks, and the effects that seed state
    // from a prop that has just arrived.
    "react/set-state-in-effect": "off",
    "react/refs": "off",

    // `accessReady` is derived from Date.now() during render on purpose: it
    // answers "is the access token still valid *now*", and a value cached in
    // state would answer for the moment it was cached.
    "react/purity": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "playwright-report", "test-results"]
}
