{
  "name": "quizproject-web",
  "version": "2.0.0",
  "private": true,
  "description": "React frontend for Quiz Project",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build && node scripts/prepare-hosting.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --enable-source-maps --import ./tests/support/register.mts --test --test-timeout=30000 tests/*.test.ts",
    "coverage": "node --enable-source-maps --import ./tests/support/register.mts --test --test-timeout=30000 --experimental-test-coverage --test-coverage-exclude='tests/**' tests/*.test.ts",
    "coverage:check": "node --import ./tests/support/register.mts --test --test-timeout=30000 --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=96 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run coverage:check && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
